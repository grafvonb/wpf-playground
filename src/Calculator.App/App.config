<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- InProcess (default) or Sql -->
    <add key="CalculatorBackend" value="Sql" />
  </appSettings>
  <connectionStrings>
    <add name="CalculatorDb"
         connectionString="Server=.;Database=CalculatorDb;Integrated Security=true;Connect Timeout=5" />
  </connectionStrings>
</configuration>
